{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CosthoundReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "ec2:DescribeVolumes",
        "ec2:DescribeInstances",
        "ec2:DescribeAddresses",
        "ec2:DescribeSnapshots",
        "ec2:DescribeImages",
        "ec2:DescribeNatGateways",
        "ec2:DescribeCapacityReservations",
        "ec2:DescribeRouteTables",
        "ec2:DescribeVpcEndpoints",
        "logs:DescribeLogGroups",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeInstanceHealth",
        "elasticloadbalancing:DescribeTags",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "secretsmanager:ListSecrets",
        "tag:GetResources",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:GetLifecyclePolicy",
        "s3:ListAllMyBuckets",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration",
        "elasticache:DescribeCacheClusters",
        "dynamodb:ListTables",
        "dynamodb:DescribeTable",
        "application-autoscaling:DescribeScalableTargets",
        "ec2:DescribeFastSnapshotRestores",
        "backup:ListBackupVaults",
        "backup:ListRecoveryPointsByBackupVault",
        "elasticfilesystem:DescribeFileSystems",
        "kinesis:ListStreams",
        "kinesis:DescribeStreamSummary",
        "ec2:DescribeImageReferences",
        "ec2:DescribeHosts",
        "ec2:DescribeInstanceTypeOfferings",
        "globalaccelerator:ListAccelerators",
        "globalaccelerator:ListListeners",
        "globalaccelerator:ListEndpointGroups",
        "globalaccelerator:ListTagsForResource",
        "kms:ListAliases",
        "kms:ListKeys",
        "kms:DescribeKey",
        "kms:ListKeyRotations",
        "rds:DescribeDBInstances",
        "rds:DescribeDBClusters",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBClusterSnapshots",
        "autoscaling:DescribeAutoScalingGroups",
        "eks:ListClusters",
        "eks:DescribeCluster",
        "eks:ListNodegroups",
        "eks:ListFargateProfiles",
        "eks:ListCapabilities",
        "route53:ListHealthChecks",
        "route53:ListHostedZones",
        "route53:GetDNSSEC",
        "route53:ListResourceRecordSets",
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:GetEventSelectors",
        "route53:ListTrafficPolicyInstances",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CosthoundPaidPlansReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeFlowLogs",
        "cloudwatch:GetMetricData",
        "eks:DescribeClusterVersions",
        "organizations:DescribeOrganization",
        "rds:DescribeDBMajorEngineVersions",
        "rds:DescribeDBEngineVersions",
        "cost-optimization-hub:ListRecommendations",
        "organizations:ListAccounts",
        "pricing:GetProducts",
        "transfer:ListServers",
        "transfer:ListUsers",
        "route53resolver:ListResolverEndpoints",
        "cloudwatch:ListMetrics",
        "es:ListDomainNames",
        "es:DescribeDomains",
        "aoss:ListCollections",
        "aoss:BatchGetCollection",
        "aoss:ListCollectionGroups",
        "aoss:BatchGetCollectionGroup",
        "bedrock:ListKnowledgeBases",
        "sagemaker:ListEndpoints",
        "sagemaker:DescribeEndpoint",
        "sagemaker:DescribeEndpointConfig",
        "redshift:DescribeClusters",
        "ec2:DescribeTransitGatewayAttachments",
        "kafka:ListClusters",
        "kafka:ListNodes",
        "ec2:DescribeClientVpnEndpoints",
        "ec2:DescribeClientVpnTargetNetworks",
        "network-firewall:ListFirewalls",
        "network-firewall:DescribeFirewall",
        "ec2:DescribeReservedInstances",
        "rds:DescribeReservedDBInstances",
        "elasticache:DescribeReservedCacheNodes",
        "es:DescribeReservedInstances",
        "redshift:DescribeReservedNodes",
        "savingsplans:DescribeSavingsPlans",
        "elasticmapreduce:ListClusters",
        "memorydb:DescribeClusters",
        "lambda:ListProvisionedConcurrencyConfigs",
        "lambda:GetProvisionedConcurrencyConfig",
        "ecs:ListClusters",
        "ecs:ListServices"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CosthoundApiGatewayListReadOnly",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:*:apigateway:*::/restapis"
      ]
    },
    {
      "Sid": "OnlyThroughEC2AMIReferenceCheck",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ssm:DescribeParameters",
        "ssm:GetParameters",
        "imagebuilder:ListImageRecipes",
        "imagebuilder:ListContainerRecipes",
        "imagebuilder:GetContainerRecipe"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": [
            "ec2-images.amazonaws.com"
          ]
        }
      }
    }
  ]
}
